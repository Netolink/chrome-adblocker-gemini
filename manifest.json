{
  "manifest_version": 3,
  "name": "AdBlocker Pro - Gemini",
  "version": "1.0",
  "description": "Advanced ad blocker based on Manifest V3, including network blocking and cosmetic filtering.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAn0lEQVR42mNkQAIsb7qA+T8SgInBAESroBgwMv6H0qgAJAasgAnmfxwAkAdgGgXm0fIAsgEwG7EGYg3EGoA1EGsA1kCsAVgDsAZgDcQaCNIAYgPIdgAxmCDbALIdQAwmyDaAbAcQgwm6DSDbAcRggm4DyHYAMZgw6McBiM0g2wEwzYIsA8gGwGzEGoA1EGsA1kCsAVgDsAZgDcQaCBIDAMXpVs9pYpZlAAAAAElFTkSuQmCC",
      "48": "data:image/png;base64,",
      "128": "data:image/png;base64,"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easylist_rules",
        "enabled": true,
        "path": "rules/easylist.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
